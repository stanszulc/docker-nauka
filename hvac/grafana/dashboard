          "rawSql": "\nWITH raw AS (\n  SELECT\n    device_id, ts, failure_type, ml_score, is_pre_failure, uptime_seconds,\n    LAG(ts) OVER (PARTITION BY device_id ORDER BY ts) AS prev_ts\n  FROM hvac_metrics\n  WHERE device_id = $device_id\n    AND ts BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz\n),\nepisodes AS (\n  SELECT *,\n    CASE WHEN failure_type != 'None'\n          AND (prev_ts IS NULL OR EXTRACT(EPOCH FROM (ts - prev_ts)) > 300)\n         THEN 1 ELSE 0 END AS episode_start\n  FROM raw\n  WHERE failure_type != 'None'\n),\nnumbered AS (\n  SELECT *,\n    SUM(episode_start) OVER (PARTITION BY device_id ORDER BY ts) AS ep_num\n  FROM episodes\n),\nagg AS (\n  SELECT\n    device_id, ep_num, failure_type,\n    MIN(ts) AS failure_ts, MAX(ts) AS failure_end,\n    COUNT(*) AS failure_ticks, AVG(ml_score) AS avg_score\n  FROM numbered\n  GROUP BY device_id, ep_num, failure_type\n),\npre AS (\n  SELECT\n    a.ep_num, a.failure_type, a.failure_ts, a.failure_ticks, a.avg_score,\n    MIN(m.ts) AS first_alert_ts,\n    COUNT(m.ts) AS alert_count\n  FROM agg a\n  LEFT JOIN hvac_metrics m ON m.device_id = a.device_id\n    AND m.ts BETWEEN a.failure_ts - INTERVAL '10 minutes' AND a.failure_ts\n    AND (m.is_pre_failure = 1 OR m.ml_score >= 0.5)\n    AND m.failure_type = 'None'\n  GROUP BY a.ep_num, a.failure_type, a.failure_ts, a.failure_ticks, a.avg_score\n)\nSELECT\n  failure_ts AS \"Timestamp awarii\",\n  failure_type AS \"Typ defektu\",\n  first_alert_ts AS \"Pierwszy alert\",\n  alert_count AS \"Liczba alertów\",\n  ROUND(EXTRACT(EPOCH FROM (failure_ts - first_alert_ts))::numeric, 0) AS \"Lead time (s)\",\n  ROUND(EXTRACT(EPOCH FROM (failure_ts - first_alert_ts))::numeric / 60, 1) AS \"Lead time (min)\",\n  failure_ticks AS \"Ticki awarii\",\n  ROUND(avg_score::numeric, 3) AS \"Avg ML score\"\nFROM pre\nORDER BY failure_ts DESC\n",
          "refId": "A"
        }
