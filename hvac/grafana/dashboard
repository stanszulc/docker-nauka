        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  s.device_id,\n  CASE \n    WHEN s.last_failure_type IS NOT NULL \n     AND s.last_failure_type != 'None' THEN s.last_failure_type\n    ELSE '⚡ pre-alarm'\n  END AS \"Defekt\",\n  CASE\n    WHEN s.last_failure_type IS NOT NULL \n     AND s.last_failure_type != 'None' THEN '🔴 FAILURE'\n    ELSE '🟡 WARNING'\n  END AS \"Status\",\n  ROUND(m.ml_score::numeric, 3) AS \"ML score\",\n  ROUND(m.fail_probability::numeric * 100, 0) || '%' AS \"Ryzyko\",\n  ROUND(s.uptime_seconds::numeric / 60, 1) AS \"Uptime (min)\",\n  ROUND(EXTRACT(EPOCH FROM (NOW() - s.last_seen))::numeric, 0) AS \"Ostatni (s)\"\nFROM hvac_device_status s\nLEFT JOIN LATERAL (\n  SELECT ml_score, fail_probability, is_pre_failure\n  FROM hvac_metrics\n  WHERE device_id = s.device_id\n  ORDER BY ts DESC LIMIT 1\n) m ON true\nWHERE s.last_seen > NOW() - INTERVAL '2 minutes'\n  AND (\n    (s.last_failure_type IS NOT NULL AND s.last_failure_type != 'None')\n    OR m.is_pre_failure = 1\n  )\nORDER BY \n  CASE WHEN s.last_failure_type IS NOT NULL AND s.last_failure_type != 'None' \n       THEN 0 ELSE 1 END,\n  m.fail_probability DESC NULLS LAST",
          "refId": "A"
        }
      ],
      "title": "🏢 Device Tower",
      "type": "table"
    },
